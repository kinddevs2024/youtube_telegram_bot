# Temporary upload endpoint; include only in the canonical HTTPS server block.
location ^~ /youtube-bot-setup/ {
    client_max_body_size 1m;
    client_body_buffer_size 1m;
    access_log off;
    error_log /var/log/nginx/youtube-bot-setup-error.log crit;
    proxy_pass http://127.0.0.1:8794;
    proxy_set_header Host logic-coin.online;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
}
